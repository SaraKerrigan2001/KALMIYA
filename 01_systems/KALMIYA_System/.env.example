USER=Sara Kerrigan
BOTNAME=KALMIYA

# ── CEREBRO DE IA ─────────────────────────────────────────────────────────────
# Modo: auto | ollama | gemini | groq | openrouter | cohere | claude
AI_MODE=auto
AI_MODEL=llama3.2

# Obtén keys en los sitios indicados — NUNCA subas el .env real a git
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI
GEMINI_MODEL=gemini-2.5-flash

CLAUDE_API_KEY=TU_CLAUDE_API_KEY_AQUI
CLAUDE_MODEL=claude-opus-4-8

GROQ_API_KEY=TU_GROQ_API_KEY_AQUI
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=TU_OPENROUTER_API_KEY_AQUI
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

COHERE_API_KEY=TU_COHERE_API_KEY_AQUI
COHERE_MODEL=command-r-plus

# ── SERVIDOR Y WALLPAPER ──────────────────────────────────────────────────────
KALMIYA_ENABLE_SERVER=false
KALMIYA_SERVER_PORT=5000
KALMIYA_ENABLE_WALLPAPER=true

# ── OBSIDIAN ──────────────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=c:\Users\maria\env

# ── TELEGRAM ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=TU_TELEGRAM_BOT_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_TELEGRAM_CHAT_ID_AQUI

# ── EMAIL ─────────────────────────────────────────────────────────────────────
EMAIL_USER=TU_CORREO@gmail.com
EMAIL_PASSWORD=TU_APP_PASSWORD_AQUI
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── MÓDULOS EXTRA ─────────────────────────────────────────────────────────────
WEATHER_API_KEY=TU_OPENWEATHERMAP_KEY_AQUI
WEATHER_DEFAULT_CITY=Cucuta
NOTAS_DIR=c:\Users\maria\env\_TEMP\notas
HABITOS_RACHA_PREMIO=7
EMOTION_CONFIDENCE_THRESHOLD=0.6
KALMIYA_DEBUG=false
